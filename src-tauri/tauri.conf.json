{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunnelium",
  "version": "0.1.0",
  "identifier": "com.tunnelium.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tunnelium",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "SSH tunnel manager",
    "longDescription": "Tunnelium is a cross-platform manager for SSH port forwarding: create, organize, and keep local, remote, and dynamic (SOCKS5) tunnels running.",
    "publisher": "Tunnelium",
    "homepage": "https://github.com/M3mby7e/tunnelium",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
